# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexus?schema=public"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# SUPER_ADMIN seed (used only by prisma/seed.ts — never through public registration)
ADMIN_NAME="Nexus Admin"
ADMIN_EMAIL="admin@nexus.local"
ADMIN_PASSWORD="change-me-before-running-seed"
